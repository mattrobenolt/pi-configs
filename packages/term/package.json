{
  "name": "term-extension",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test index.test.ts",
    "test:integration": "TERM_INTEGRATION=1 node --experimental-strip-types --test integration.test.ts",
    "fmt": "oxfmt *.ts",
    "fmt:check": "oxfmt *.ts --check",
    "lint": "oxlint *.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
