{
  "packages": [
    "./packages/better-diff",
    "./packages/memory",
    "./packages/slack",
    "./packages/notion",
    "./packages/webfetch",
    "./packages/term",
    "./packages/todos",
    "git:github.com/ocodista/pi-token-bloat",
    "git:github.com/nicobailon/pi-subagents",
    "git:github.com/nicobailon/pi-mcp-adapter",
    "git:github.com/HazAT/pi-ghostty",
    "git:github.com/championswimmer/pi-cache-graph"
  ],
  "lastChangelogVersion": "0.82.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "theme": "dracula",
  "transport": "sse",
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "enabledModels": [],
  "steeringMode": "all",
  "quietStartup": true,
  "editorPaddingX": 1,
  "showHardwareCursor": true,
  "treeFilterMode": "default",
  "slack": {
    "workspaceUrl": "https://planetscale.slack.com"
  },
  "doubleEscapeAction": "tree",
  "followUpMode": "all",
  "terminal": {
    "showTerminalProgress": true
  },
  "webfetch": {
    "objectiveModel": "fireworks/accounts/fireworks/models/gpt-oss-120b"
  },
  "github": {
    "ciWatch": {
      "enabled": true
    }
  }
}
