{
  "packages": [
    "./packages/better-diff",
    "./packages/memory",
    "./packages/slack",
    "./packages/notion",
    "./packages/webfetch",
    "./packages/term",
    "./packages/todos",
    "git:github.com/ocodista/pi-token-bloat",
    "git:github.com/mattrobenolt/pi-subagents@fireworks-schema-compat",
    "git:github.com/nicobailon/pi-mcp-adapter",
    "git:github.com/HazAT/pi-ghostty",
    "git:github.com/championswimmer/pi-cache-graph",
    "git:github.com/dbachelder/pi-btw"
  ],
  "lastChangelogVersion": "0.74.0",
  "defaultProvider": "omlx",
  "defaultModel": "Qwen3.6-35B-A3B-4bit",
  "defaultThinkingLevel": "medium",
  "theme": "dracula",
  "transport": "sse",
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "enabledModels": [],
  "steeringMode": "all",
  "quietStartup": true,
  "editorPaddingX": 1,
  "showHardwareCursor": true,
  "treeFilterMode": "default",
  "slack": {
    "workspaceUrl": "https://planetscale.slack.com"
  },
  "doubleEscapeAction": "tree",
  "followUpMode": "all",
  "terminal": {
    "showTerminalProgress": true
  },
  "webfetch": {
    "objectiveModel": "openai-codex/gpt-5.6-luna"
  }
}
